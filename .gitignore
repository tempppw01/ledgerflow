node_modules
dist
coverage
.vscode
.DS_Store
*.log

# Local runtime data and credentials
.env
.env.*
!.env.example
# 前导 / 不能省:写成 data/ 会匹配**任意层级**的 data 目录,
# 于是哪天有人在 src/ 下建一个 data/,那里的源码会静默进不了仓库,而 git status 一直显示干净。
/data/

# Browser automation artifacts
.playwright-cli/
.playwright-mcp/
playwright-report/
test-results/
/playwright.config.ts

# Local Codex preview/runtime state
.codex-run/

# Local AI/browser audit scratch directories
/.audit/
/.tmp-i18n/
/e2e-artifacts/

# One-off local maintenance output
/output/
/*.py
/test-optimization.ps1
/narrow-check.png
/screenshot.png
/OPTIMIZATION_COMPLETE.md
/OPTIMIZATION_SUMMARY.md

# check-i18n-keys.mjs --json 的输出,按需生成
.i18n-report.json

# 临时脚本(重构/迁移用的 .tmp-*.mjs 等):一律不入库,避免 git add -A 误收
.tmp-*
