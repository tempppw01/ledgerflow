# 直连远程后端域名（必填），示例：https://api.your-domain.com
VITE_API_BASE_URL=
VITE_REQUEST_TIMEOUT_MS=8000
VITE_LOG_LEVEL=info

# 可按后端路由覆盖同步接口（默认 /sync-local-data、/sync-change）
VITE_SYNC_LOCAL_DATA_PATH=/sync-local-data
VITE_SYNC_CHANGE_PATH=/sync-change

# MySQL 快照 API（服务端读取，前端不应暴露这些值）
# MYSQL_HOST 填阿里云 RDS 的内网或外网连接地址，不需要本地 MySQL 容器。
LEDGERFLOW_API_PORT=8787
LEDGERFLOW_MAX_BODY_BYTES=52428800
LEDGERFLOW_API_PROXY_TARGET=http://127.0.0.1:8787
# MySQL 快照 API 必填令牌，请使用足够长的随机字符串，并在页面同步面板中输入同一令牌。
LEDGERFLOW_API_TOKEN=
# 可选：限制 WebDAV 同源代理只允许访问这些域名，多个域名用英文逗号分隔。
LEDGERFLOW_WEBDAV_ALLOWED_HOSTS=
MYSQL_HOST=rm-xxxx.mysql.rds.aliyuncs.com
MYSQL_PORT=3306
MYSQL_USER=ledgerflow
MYSQL_PASSWORD=
MYSQL_DATABASE=ledgerflow
MYSQL_SSL=false

VITE_AI_BASE_URL=https://ai.shuaihong.fun/v1
VITE_AI_API_KEY=
VITE_AI_DEFAULT_MODEL=gpt-4o-mini

# 汇率 API（默认 frankfurter.app，免费无需 key）
VITE_EXCHANGE_API_BASE=https://api.frankfurter.app
VITE_EXCHANGE_API_TIMEOUT_MS=10000
